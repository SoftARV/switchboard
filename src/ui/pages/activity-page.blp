using Gtk 4.0;
using Adw 1;

template $SwitchboardActivityPage : Adw.Bin {

  child: Stack stack {
    transition-type: crossfade;

    StackPage {
      name: "empty";

      child: Adw.StatusPage {
        icon-name: "view-list-symbolic";
        title: "Nothing blocked yet";
        description: "Applications that cardwire keeps off a GPU show up here.";
      };
    }

    StackPage {
      name: "list";

      child: ScrolledWindow {
        vexpand: true;
        hscrollbar-policy: never;

        child: Adw.Clamp {
          maximum-size: 540;

          child: Box {
            orientation: vertical;
            spacing: 12;
            margin-top: 18;
            margin-bottom: 24;
            margin-start: 12;
            margin-end: 12;

            Label summary {
              xalign: 0;
              wrap: true;

              styles ["dim-label", "caption"]
            }

            // .boxed-list only matches GtkListBox (css node "list"), so the
            // card look is a wrapper plus the list view's own separators.
            Box {
              orientation: vertical;

              styles ["card", "events-card"]

              ListView list_view {
                show-separators: true;
              }
            }
          };
        };
      };
    }
  };
}
